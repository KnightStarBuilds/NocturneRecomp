# OpenOrbis is a cross target even when the build host is macOS.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(NOCTURNE_PS4 ON CACHE BOOL "Build the PS4 homebrew application" FORCE)
set(NOCTURNE_BUILD_TAG "PS4-x86_64" CACHE STRING "PS4 build identity")
if(NOT DEFINED OO_PS4_TOOLCHAIN)
    set(OO_PS4_TOOLCHAIN "$ENV{OO_PS4_TOOLCHAIN}" CACHE PATH "OpenOrbis SDK root")
endif()
if(NOT EXISTS "${OO_PS4_TOOLCHAIN}/lib/crt1.o")
    message(FATAL_ERROR "Set OO_PS4_TOOLCHAIN to the prepared OpenOrbis SDK, or use ps4/build.sh")
endif()
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
if(NOT EXISTS "${NOCTURNE_PS4_SDK_INCLUDE}/bits/alltypes.h")
    message(FATAL_ERROR "Run ps4/build.sh to prepare the PS4 SDK header overlay")
endif()
set(CMAKE_C_FLAGS_INIT "-fPIC -funwind-tables -D_GNU_SOURCE -D__ORBIS__ -isystem \"${NOCTURNE_PS4_SDK_INCLUDE}\" -isystem \"${OO_PS4_TOOLCHAIN}/include\"")
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem \"${OO_PS4_TOOLCHAIN}/include/c++/v1\" ${CMAKE_C_FLAGS_INIT}")
# Use the ELF linker directly: the host compiler driver's runtime defaults
# (including FreeBSD libpthread/libm) are not the OpenOrbis runtime.
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "${CMAKE_C_LINK_EXECUTABLE}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m elf_x86_64 -pie --eh-frame-hdr -T\"${OO_PS4_TOOLCHAIN}/link.x\" -L\"${OO_PS4_TOOLCHAIN}/lib\" \"${OO_PS4_TOOLCHAIN}/lib/crt1.o\"")
set(CMAKE_C_STANDARD_LIBRARIES "-lc -lkernel" CACHE STRING "PS4 C runtime")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc -lkernel" CACHE STRING "PS4 C++ runtime")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OO_PS4_TOOLCHAIN NOCTURNE_PS4_SDK_INCLUDE CMAKE_LINKER CMAKE_AR CMAKE_RANLIB)
